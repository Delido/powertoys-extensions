<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap3 rescap desktop6">

  <!-- Publisher must match the subject of the signing certificate (scripts\new-certificate.ps1) -->
  <Identity Name="Delido.PowerToysExtensions" Publisher="CN=Delido" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Delido PowerToys Extensions</DisplayName>
    <PublisherDisplayName>Delido</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Helpers and extensions share files with Raycast and other tools in %APPDATA%: no per-package copies -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Delido PowerToys Extensions"
        Description="Command Palette extensions by Delido"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- One COM class per extension; every class is served by the same process -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="PowerToysExtensions.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Delido PowerToys Extensions">
              <com:Class Id="AED9D9F3-C822-4EC2-9C30-B632C5293A98" DisplayName="Keep Awake" />
              <com:Class Id="C8E879D1-D35B-4FB7-93DC-269705348DB5" DisplayName="Launcher Key" />
              <com:Class Id="9F581994-065F-44D0-B6F1-A2E5F3DBFB53" DisplayName="BookStack" />
              <com:Class Id="9AEC9729-A270-40D2-BA86-780721AA64AD" DisplayName="OneDev" />
              <com:Class Id="EF36641F-2607-41D0-82D9-1DD1169D0D8C" DisplayName="Checkmk" />
              <com:Class Id="874E31EE-457E-4C41-93E1-0FF6B4A3ED1B" DisplayName="Snipe-IT" />
              <com:Class Id="E1E42D05-6701-4E8B-9D0D-CA638E908459" DisplayName="CS2 Nades" />
              <com:Class Id="A8FEC8D3-23D2-4CF0-8D95-2E549EF2F024" DisplayName="AMP" />
              <com:Class Id="8B555E16-BD45-431F-8AFF-8CD8B56BD750" DisplayName="Power Plan" />
              <com:Class Id="B03F6BE3-D6A0-4CDB-960C-61F656A4AC25" DisplayName="MTR" />
              <com:Class Id="8082F478-79FE-4756-8086-CBC290CF8F26" DisplayName="SignalRGB" />
              <com:Class Id="3DB56E8C-615F-406D-B131-0A5909ADDAF4" DisplayName="Paperless-ngx" />
              <com:Class Id="ADC097CC-3638-4EF1-AC55-6182E2CD8836" DisplayName="SSH Sessions" />
              <com:Class Id="4535C230-FEAA-44FF-9A8C-01020DAAC142" DisplayName="LAPS Connect" />
              <com:Class Id="AAAADC85-C95B-4980-AC50-5A59BC1DE2F3" DisplayName="SharePoint" />
              <com:Class Id="611DC4FC-7EA8-44BA-8712-FCB418060C97" DisplayName="Microsoft Teams" />
              <com:Class Id="94557F86-907B-49E8-83BC-5DC511C0199C" DisplayName="Defender Schwachstellen" />
              <com:Class Id="E8DC0AC9-D09B-463E-8081-EEB3792529D0" DisplayName="GPT4Free" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="KeepAwake" PublicFolder="Public"
            DisplayName="Keep Awake" Description="Keep the computer awake, optionally keep the Teams status available">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="AED9D9F3-C822-4EC2-9C30-B632C5293A98" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>

        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="LauncherKey" PublicFolder="Public"
            DisplayName="Launcher Key" Description="Open Command Palette by tapping the Windows key">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="C8E879D1-D35B-4FB7-93DC-269705348DB5" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="BookStack" PublicFolder="Public"
            DisplayName="BookStack" Description="Search the wiki, read books and pages">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="9F581994-065F-44D0-B6F1-A2E5F3DBFB53" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="OneDev" PublicFolder="Public"
            DisplayName="OneDev" Description="Search projects, issues, pull requests and builds">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="9AEC9729-A270-40D2-BA86-780721AA64AD" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Checkmk" PublicFolder="Public"
            DisplayName="Checkmk" Description="Problems, hosts and services, acknowledge and downtimes, background problem monitor">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="EF36641F-2607-41D0-82D9-1DD1169D0D8C" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="SnipeIt" PublicFolder="Public"
            DisplayName="Snipe-IT" Description="Assets, users, licenses and stock, check-in and check-out, audits">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="874E31EE-457E-4C41-93E1-0FF6B4A3ED1B" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Cs2Nades" PublicFolder="Public"
            DisplayName="CS2 Nades" Description="Smoke, molotov, flash and HE lineups of the Premier maps with video, live from csnades.gg">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="E1E42D05-6701-4E8B-9D0D-CA638E908459" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Amp" PublicFolder="Public"
            DisplayName="AMP" Description="Control CubeCoders AMP game servers: start/stop, console, players, backups, settings, new servers">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="A8FEC8D3-23D2-4CF0-8D95-2E549EF2F024" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="PowerPlan" PublicFolder="Public"
            DisplayName="Power Plan" Description="Switch power plans, high performance automatically while gaming">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="8B555E16-BD45-431F-8AFF-8CD8B56BD750" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Mtr" PublicFolder="Public"
            DisplayName="MTR" Description="Traceroute like WinMTR with graphs, background monitoring, alerts, HTML report">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="B03F6BE3-D6A0-4CDB-960C-61F656A4AC25" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="SignalRgb" PublicFolder="Public"
            DisplayName="SignalRGB" Description="PC sensors, lighting, headset mute and battery, keyboard game mode, CS2 integration, TeamSpeak mute, audio output">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="8082F478-79FE-4756-8086-CBC290CF8F26" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Paperless" PublicFolder="Public"
            DisplayName="Paperless-ngx" Description="Search, edit, download and upload documents, protected by a password or Windows Hello">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="3DB56E8C-615F-406D-B131-0A5909ADDAF4" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Ssh" PublicFolder="Public"
            DisplayName="SSH Sessions" Description="Find and connect to SSH hosts, team host lists, SOCKS tunnel with browser, SFTP file browser">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="ADC097CC-3638-4EF1-AC55-6182E2CD8836" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="LapsConnect" PublicFolder="Public"
            DisplayName="LAPS Connect" Description="Find a device's WireGuard IP, fetch its Windows LAPS password from Entra, connect via SSH or RDP, protected by a password or Windows Hello">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="4535C230-FEAA-44FF-9A8C-01020DAAC142" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="SharePoint" PublicFolder="Public"
            DisplayName="SharePoint" Description="Search SharePoint documents, pages and sites">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="AAAADC85-C95B-4980-AC50-5A59BC1DE2F3" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Teams" PublicFolder="Public"
            DisplayName="Microsoft Teams" Description="People, chats, channels, messages, status and meetings">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="611DC4FC-7EA8-44BA-8712-FCB418060C97" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="Defender" PublicFolder="Public"
            DisplayName="Defender Schwachstellen" Description="Vulnerability report, search and top actions from Microsoft Defender">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="94557F86-907B-49E8-83BC-5DC511C0199C" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette" Id="G4f" PublicFolder="Public"
            DisplayName="GPT4Free" Description="Ask AI, chat, text commands and images with your own AI APIs">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation><CreateInstance ClassId="E8DC0AC9-D09B-463E-8081-EEB3792529D0" /></Activation>
                <SupportedInterfaces><Commands /></SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
